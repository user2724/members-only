<html>

<title>Message Board</title>

<body>
<h1>Welcome to the Message Board!</h1>

<% if (locals.messages) { %>
    <% messages.forEach(message => { %>
        <div class="message-container">
            <ul>

                <li><%= message.message_text %></li>
 <% if (locals.user) { %>
    <% if (user.has_membership) { %>
<li><%= message.date %></li> 
   <% } %>
<% } %>




</ul>
</div>
  <%  }) %>
    
<% } %>
    

</body>

</html>