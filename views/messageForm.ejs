<html>


<body>


<h1>Create New Message</h1>

<form action="/messageForm" method="POST">

<!--<label for="message" id="message-label">Your Message Here:</label>-->
<textarea name="messageText" id="message-input" rows="6" cols="50" placeholder="Your message here..."></textarea>
<% if (locals.user) { %>

    <input type="hidden" name="author" id="author" value="<%= user.first_name %> <%= user.last_name%>">
<% } %>

<button type="submit">Create Message</button>

</form>

</body>

</html>